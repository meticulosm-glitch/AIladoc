# ---------------------------------------------------------------- generale
APP_NAME=AIladoc
COMPANY_NAME=Meticulo
# URL pubblico dell'app (usato per il redirect di login/logout)
BASE_URL=http://localhost:8000
# Genera con:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiami-con-una-stringa-lunga-e-casuale
# true quando l'app è servita in HTTPS
COOKIE_SECURE=false
SESSION_MAX_AGE=28800

# ---------------------------------------------------------------- Keycloak
# Keycloak è esterno all'app.
# URL di Keycloak visto dal BROWSER (senza /realms/...)
KEYCLOAK_PUBLIC_URL=https://sso.example.com
# URL di Keycloak visto dal CONTAINER, se diverso (es. servizio interno). Vuoto = uguale al pubblico
KEYCLOAK_INTERNAL_URL=
KEYCLOAK_REALM=ailadoc
OIDC_CLIENT_ID=ailadoc
# vuoto se il client Keycloak è pubblico (si usa comunque PKCE)
OIDC_CLIENT_SECRET=
# CA aggiuntiva (PEM) se Keycloak usa un certificato di una CA interna
OIDC_CA_FILE=
OIDC_SCOPES=openid profile email
# Claim aggiuntivi da cui leggere ruoli/gruppi (oltre a realm_access e resource_access)
ROLES_EXTRA_CLAIMS=roles,groups

# ---------------------------------------------------------------- pagina di login
# form     = pagina di login dell'app: nome utente e password li verifica Keycloak lato server
#            (sul client Keycloak attiva "Direct access grants"); l'utente non vede la pagina di Keycloak
# redirect = si va alla pagina di login di Keycloak
LOGIN_MODE=form
# Aggiunge "Accedi con Single Sign-On" (pagina di Keycloak: provider esterni, passkey)
LOGIN_SSO_BUTTON=false
# Campo "Codice di verifica" per chi ha l'OTP attivo in Keycloak
LOGIN_OTP=false
# Link "Password dimenticata?": vuoto = nascosto, keycloak = reset del realm, oppure un URL
PASSWORD_RESET_URL=
# Tentativi falliti in 10 minuti per utente e IP (attiva anche la Brute force detection del realm)
LOGIN_MAX_ATTEMPTS=10

# Ruoli Keycloak:
# - ADMIN_ROLES sono SEMPRE amministratori (anti lock-out)
# - EDITOR_ROLES / VIEWER_ROLES creano i ruoli app iniziali al primo avvio,
#   poi si gestiscono da Amministrazione -> Ruoli app
ADMIN_ROLES=ailadoc-admin
EDITOR_ROLES=ailadoc-editor
VIEWER_ROLES=ailadoc-viewer

# ---------------------------------------------------------------- contenuti
MAX_UPLOAD_MB=100
OFFICE_PREVIEW=true
OFFICE_PREVIEW_TIMEOUT=120
# Copia i documenti di esempio se data/docs è vuota (solo per provare)
SEED_SAMPLE_DOCS=false

# ---------------------------------------------------------------- password nei documenti
# Controlla Markdown, PDF, Word, PowerPoint, Excel/CSV e testo alla ricerca di password e credenziali
SECRETS_SCAN=true
# warn  = salva ma avvisa (in modifica chiede conferma), segnala in Amministrazione
# block = rifiuta il salvataggio o il caricamento finché le password non vengono tolte
SECRETS_POLICY=warn
# Ogni quanti secondi, al massimo, ricontrollare i file cambiati (anche copiati a mano)
SECRETS_RESCAN_SECONDS=30

# Login simulato senza Keycloak: SOLO per sviluppo locale
AUTH_DEV_MODE=false

# ---------------------------------------------------------------- assistente AIla
ASSISTANT_ENABLED=true
ASSISTANT_NAME=AIla
# Domande d'esempio nel pannello, separate da |
ASSISTANT_SUGGESTIONS=
# Senza LLM l'assistente indica i documenti più pertinenti (nessun dato esce dal container).
# Con Claude basta la chiave:
ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-haiku-5-5
# Oppure un'API compatibile OpenAI (Ollama, vLLM, LM Studio, Azure OpenAI...):
# ASSISTANT_LLM=openai
# ASSISTANT_BASE_URL=http://ollama:11434/v1
# ASSISTANT_MODEL=llama3.1
# ASSISTANT_API_KEY=
ASSISTANT_RATE_PER_MINUTE=20

# ---------------------------------------------------------------- metriche Prometheus
# GET /metrics: richieste e tempi di risposta, assistente/LLM, LibreOffice, login, scansioni
METRICS_ENABLED=true
# Se impostato, /metrics richiede "Authorization: Bearer <token>" (consigliato se l'app è su Internet)
METRICS_TOKEN=

# ---------------------------------------------------------------- plugin delle pagine
# all oppure elenco tra: drawio, tables, macros
PLUGINS=all
# Editor draw.io incorporato (gira nel browser; il diagramma non passa dai server di draw.io).
# Istanza interna: docker run -p 8080:8080 jgraph/drawio  ->  DRAWIO_EDITOR_URL=https://drawio.azienda.it
# Vuoto = i diagrammi si vedono ma non si modificano.
DRAWIO_EDITOR_URL=https://embed.diagrams.net
# Siti ammessi nella macro "embed" (vuoto = Figma, Miro, Google, Microsoft 365, YouTube, Vimeo, Loom...)
# EMBED_ALLOWED_HOSTS=www.figma.com,miro.com,docs.google.com,*.sharepoint.com
